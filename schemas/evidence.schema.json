{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:starter-series:take-a-repo:schema:evidence:v1",
  "title": "Producer evidence (not a QA verdict or publication permission)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assets", "checks"],
  "properties": {
    "version": { "const": 1 },
    "assets": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "mediaType", "role"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "mediaType": { "enum": ["image/png", "video/mp4", "video/webm", "video/quicktime", "application/json", "text/plain", "text/markdown"] },
          "role": { "enum": ["screenshot", "recording", "transcript", "request-response", "check-result", "artifact"] },
          "description": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "checks": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "summary", "assets"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "status": { "enum": ["pass", "fail", "unverified"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } }
        }
      }
    }
  },
  "definitions": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" } }
}
