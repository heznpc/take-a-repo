{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:take-a-repo:production-observations:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "createdAt", "authority", "analyzer", "tool", "source", "recipe", "frames"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "take-a-repo.observations" },
    "createdAt": { "type": "string" },
    "authority": { "const": "observation-only" },
    "analyzer": { "$ref": "#/definitions/hash" },
    "tool": { "$ref": "#/definitions/hash" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256", "durationSeconds"],
      "properties": { "ref": { "type": "string" }, "sha256": { "$ref": "#/definitions/hash" }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["intervalSeconds", "width", "maxFrames"],
      "properties": {
        "intervalSeconds": { "type": "number", "minimum": 0.25 },
        "width": { "type": "integer", "minimum": 160, "maximum": 1280 },
        "maxFrames": { "type": "integer", "minimum": 2, "maximum": 1000 }
      }
    },
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["atSeconds", "path", "sha256", "bytes", "width", "height"],
        "properties": {
          "atSeconds": { "type": "number", "minimum": 0 },
          "path": { "type": "string", "pattern": "^frame-[0-9]+\\.png$" },
          "sha256": { "$ref": "#/definitions/hash" },
          "bytes": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1, "maximum": 1280 },
          "height": { "type": "integer", "minimum": 1, "maximum": 1280 }
        }
      }
    }
  },
  "definitions": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
